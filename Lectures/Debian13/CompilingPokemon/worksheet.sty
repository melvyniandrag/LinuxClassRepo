\newcommand{\myfig}[3]{%
\begin{figure}[h]
    \centering
    \begin{mdframed}[linewidth=1pt, linecolor=black]  % optional border
        \includegraphics[width=\textwidth]{#1}
    \end{mdframed}
    \caption{\small \texttt{#2}}
    \label{#3}
\end{figure}
}

\newcommand{\myfigtwo}[3]{%
\begin{figure}[h]
    \centering
    \begin{mdframed}[linewidth=1pt, linecolor=black]  % optional border
        \includegraphics[width=0.5\textwidth]{#1}
    \end{mdframed}
    \caption{\small \texttt{#2}}
    \label{#3}
\end{figure}
}

